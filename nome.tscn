[gd_scene format=3]

[ext_resource type="Script" path="res://nome.gd" id="1"]

[node name="Nome" type="VBoxContainer"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 60.0
offset_top = 60.0
offset_right = -60.0
offset_bottom = -60.0
theme_override_constants/separation = 30
script = ExtResource("1")

[node name="Entrada" type="LineEdit" parent="."]
